# Copy this file to .env and fill in your Bybit testnet API key.
# Never commit .env.

# Bybit testnet credentials (https://testnet.bybit.com -> API Management)
# Not needed when DRY_RUN=1
BYBIT_TESTNET_API_KEY=your_testnet_api_key
BYBIT_TESTNET_API_SECRET=your_testnet_api_secret

# TESTNET, DEMO or MAINNET
BYBIT_ENVIRONMENT=TESTNET

# 1 = market data only, no orders sent; 0 = sends the two sell orders
DRY_RUN=1

# Contracts per leg (Bybit minimum is 0.01)
STRADDLE_QTY=0.01

# 0 = nearest expiry at least 6h away, 1 = next, ...
STRADDLE_EXPIRY_INDEX=0

# LIMIT or MARKET
STRADDLE_ORDER_TYPE=LIMIT

# Settlement currency of the options: USDT or USDC
STRADDLE_QUOTE_CCY=USDT
